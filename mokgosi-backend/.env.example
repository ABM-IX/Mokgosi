# Mokgosi Backend Environment Variables Specification (Two-Pillar: Public Safety & GBV)

# --- Supabase Database & Auth ---
# Required for incident persistence, safe network, evidence metadata, and RLS
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Forensic Evidence Vault ---
# Process-stable Ed25519 seed for manifests and ack/bundle tokens. Run `python scripts/gen_key.py`:
# it writes the seed into .env and prints only the public key. Left empty, the API refuses to start.
ED25519_PRIVATE_KEY_SEED=
# Earlier keys, so old evidence stays verifiable: <public_key_hex>:retired|compromised, comma-separated.
ED25519_PUBLIC_KEYRING=
EVIDENCE_STORAGE_BUCKET=evidence-media

# --- Device & Responder Authentication ---
# Comma-separated list of pre-shared device API keys accepted in X-Device-Key header
DEVICE_API_KEYS=replace-with-a-long-random-per-device-key
# App gate only: this key ships inside every APK. Survivor data is protected by per-device tokens.
# Requests per minute per registered device, and per IP for everyone.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_IP_PER_MINUTE=120
REGISTRATIONS_PER_IP_PER_HOUR=20
# API Base URL used in generated SMS acknowledgement links and bundle download URLs
API_BASE_URL=http://localhost:8000

# --- Responder Authentication & Demo Mode ---
DEMO_MODE=false
DEMO_RESPONDER_TOKEN=
DEMO_RESPONDER_ID=DISP_GABORONE_01
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Trusted Person & Safe Network Escalation ---
# Provider options: console (DEMO), webhook, twilio
NOTIFIER_PROVIDER=console
# Escalation timeout in seconds before escalating to next contact in safe network (short in demo e.g. 5)
ESCALATION_SECONDS=5.0
TRUSTED_NOTIFIER_WEBHOOK_URL=

# --- Twilio SMS Integration (Optional production carrier path) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

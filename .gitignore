# Never commit credentials or local configuration. render.yaml holds `sync: false` placeholders only;
# scripts/check_no_secrets.py (run by the backend tests) fails on seeds, JWTs and inline secrets.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.seed
secrets/
render.local.yaml

# Generated builds and caches.
.venv/
venv/
node_modules/
dist/
build/
.dart_tool/
.flutter-plugins-dependencies
.idea/
**/android/.gradle/
**/android/local.properties
__pycache__/
.pytest_cache/
*.py[cod]
